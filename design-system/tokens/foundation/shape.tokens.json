{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Radii, stroke widths, dash patterns and card geometry, in output pixels.",
  "rounded": {
    "$type": "dimension",
    "badge": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "card": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "connector": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "frame": {
      "$value": {
        "value": 14,
        "unit": "px"
      }
    },
    "canvas": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    }
  },
  "stroke": {
    "$type": "dimension",
    "card": {
      "$value": {
        "value": 1,
        "unit": "px"
      }
    },
    "icon": {
      "$value": {
        "value": 1.7,
        "unit": "px"
      }
    },
    "connector": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "frame": {
      "$value": {
        "value": 1.1,
        "unit": "px"
      }
    }
  },
  "dash": {
    "$type": "strokeStyle",
    "external": {
      "$value": {
        "dashArray": [
          {
            "value": 5,
            "unit": "px"
          },
          {
            "value": 4,
            "unit": "px"
          }
        ],
        "lineCap": "butt"
      }
    },
    "frame": {
      "$value": {
        "dashArray": [
          {
            "value": 6,
            "unit": "px"
          },
          {
            "value": 5,
            "unit": "px"
          }
        ],
        "lineCap": "butt"
      }
    },
    "edge": {
      "$value": {
        "dashArray": [
          {
            "value": 4,
            "unit": "px"
          },
          {
            "value": 4,
            "unit": "px"
          }
        ],
        "lineCap": "butt"
      }
    },
    "lifeline": {
      "$value": {
        "dashArray": [
          {
            "value": 2,
            "unit": "px"
          },
          {
            "value": 5,
            "unit": "px"
          }
        ],
        "lineCap": "butt"
      },
      "$description": "A sequence's lifeline: fainter than any other dash, a guide the messages hang from."
    },
    "reply": {
      "$value": "{dash.edge}",
      "$description": "A reply in a sequence (UML 2.5.1, 17.4.4.1); a sequence has no edge taken only sometimes, so the two never meet."
    },
    "operand": {
      "$value": "{dash.frame}",
      "$description": "The line between two operands of a fragment (UML 2.5.1, 17.6.4.1)."
    }
  },
  "arrowhead": {
    "$type": "dimension",
    "$description": "The open arrowhead at an edge's end: how far its legs reach back along the line, how wide it opens across it, and the gap its tip leaves before the card.",
    "length": {
      "$value": {
        "value": 7,
        "unit": "px"
      }
    },
    "width": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "gap": {
      "$value": {
        "value": 3,
        "unit": "px"
      }
    }
  },
  "label": {
    "$type": "dimension",
    "$description": "An edge label's text: the widest it runs on one line before it wraps onto two.",
    "max-width": {
      "$value": {
        "value": 120,
        "unit": "px"
      }
    }
  },
  "legend": {
    "$type": "dimension",
    "$description": "A legend entry's swatch: its size, and the gap before its text.",
    "swatch": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "swatch-gap": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    }
  },
  "card": {
    "$type": "dimension",
    "horizontal-height": {
      "$value": {
        "value": 56,
        "unit": "px"
      }
    },
    "horizontal-min-width": {
      "$value": {
        "value": 184,
        "unit": "px"
      }
    },
    "horizontal-badge": {
      "$value": {
        "value": 36,
        "unit": "px"
      }
    },
    "horizontal-icon": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "vertical-min-width": {
      "$value": {
        "value": 132,
        "unit": "px"
      }
    },
    "vertical-height": {
      "$value": {
        "value": 112,
        "unit": "px"
      }
    },
    "vertical-badge": {
      "$value": {
        "value": 44,
        "unit": "px"
      }
    },
    "vertical-icon": {
      "$value": {
        "value": 30,
        "unit": "px"
      }
    },
    "padding": {
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "multi-offset": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "logo-corner": {
      "$value": {
        "value": 18,
        "unit": "px"
      }
    },
    "logo-chip": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "logo-chip-ring": {
      "$value": {
        "value": 18,
        "unit": "px"
      }
    },
    "logo-inline": {
      "$value": "{card.logo-chip}",
      "$description": "A logo leading a card's note line, as tall as the note's letters."
    },
    "logo-inline-gap": {
      "$value": {
        "value": 4,
        "unit": "px"
      },
      "$description": "Between an inline logo and the text after it."
    }
  },
  "spacing": {
    "$type": "dimension",
    "node-node": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "edge-edge": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "layer-layer": {
      "$value": {
        "value": 52,
        "unit": "px"
      }
    },
    "pack": {
      "$value": "{spacing.layer-layer}",
      "$description": "Between parts of a diagram that share nothing: the largest part and the rows of the others below it."
    },
    "frame-padding": {
      "$value": {
        "value": 22,
        "unit": "px"
      }
    },
    "frame-label": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "margin": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "legend": {
      "$value": {
        "value": 28,
        "unit": "px"
      },
      "$description": "Between the diagram and its legend below it."
    },
    "legend-entry": {
      "$value": {
        "value": 20,
        "unit": "px"
      },
      "$description": "Between two entries of the legend in a row."
    },
    "legend-row": {
      "$value": {
        "value": 10,
        "unit": "px"
      },
      "$description": "Between two rows of the legend."
    },
    "message-row": {
      "$value": {
        "value": 42,
        "unit": "px"
      },
      "$description": "The step from one message of a sequence to the next, down the page: a label of two lines above its line (typography.subtitle, 2 × 12 × 1.2 = 28.8) and spacing.edge-edge, rounded up."
    },
    "lifeline-gap": {
      "$value": "{spacing.node-node}",
      "$description": "The least room between two participants' heads in a sequence, as between two cards."
    },
    "self-width": {
      "$value": "{rounded.connector}",
      "$description": "How far a message to its own lifeline reaches out, one rounded bend each way."
    },
    "fragment-padding": {
      "$value": "{spacing.frame-padding}",
      "$description": "Room inside a sequence fragment's frame round what it holds, as a frame's."
    },
    "fragment-tag": {
      "$value": "{spacing.frame-label}",
      "$description": "The height of a fragment's pentagon tag, at its frame's top left, as a frame's name."
    }
  }
}
