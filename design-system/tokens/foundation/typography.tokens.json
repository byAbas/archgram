{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Type. Sizes are output pixels.",
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": [
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "Helvetica",
        "Arial",
        "sans-serif"
      ]
    }
  },
  "typography": {
    "$type": "typography",
    "title": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 14,
          "unit": "px"
        },
        "fontWeight": 500,
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "subtitle": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 400,
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "message": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 500,
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "A sequence call's label: a subtitle's size, a title's weight, so the main path reads first."
    },
    "frame-label": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 11,
          "unit": "px"
        },
        "fontWeight": 500,
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0.88,
          "unit": "px"
        }
      }
    },
    "legend": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 400,
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  }
}
