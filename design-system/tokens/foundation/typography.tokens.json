{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Type. Sizes are output pixels.",
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": [
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "Helvetica",
        "Arial",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": [
        "ui-monospace",
        "SF Mono",
        "Menlo",
        "Consolas",
        "Liberation Mono",
        "monospace"
      ],
      "$description": "A sequence's words between its heads, a blueprint's face. The renderer embeds Geist Mono; this is the fallback stack."
    }
  },
  "typography": {
    "$type": "typography",
    "title": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 14,
          "unit": "px"
        },
        "fontWeight": 500,
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "subtitle": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 400,
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "message": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 500,
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "A sequence call's or send's words: a title's weight, so the main path reads first."
    },
    "message-reply": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 400,
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "A sequence reply's words: a subtitle's weight, quieter than the call."
    },
    "message-number": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 400,
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "A sequence message's number, in brackets before its words."
    },
    "phase": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": {
          "value": 11,
          "unit": "px"
        },
        "fontWeight": 500,
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "A sequence phase's name, in capitals."
    },
    "fragment": {
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": {
          "value": 10,
          "unit": "px"
        },
        "fontWeight": 500,
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "A sequence fragment's operator and guards in its pill, and the \"or\"."
    },
    "frame-label": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 11,
          "unit": "px"
        },
        "fontWeight": 500,
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0.88,
          "unit": "px"
        }
      }
    },
    "legend": {
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 400,
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  }
}
